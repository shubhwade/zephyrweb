{
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "redirects": [
    {
      "source": "/linkedin",
      "destination": "https://www.linkedin.com/company/thakurengineering/posts/?feedView=all",
      "permanent": false
    },
    {
      "source": "/linkedin/(.*)",
      "destination": "https://www.linkedin.com/company/thakurengineering/posts/?feedView=all",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
